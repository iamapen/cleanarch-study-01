{
    "name": "iamapen/cleanarch-study-01",
    "description": "写経：手を動かしてわかるクリーンアーキテクチャ",
    "type": "project",
    "scripts": {
        "phpcs": "vendor/bin/phpcs --standard=phpcs-rule.xml src bin",
        "phpcbf": "vendor/bin/phpcbf --standard=phpcs-rule.xml src bin",
        "post-install-cmd": [
            "cp _dev/hooks/pre-commit .git/hooks/pre-commit",
            "chmod +x .git/hooks/pre-commit"
        ]
    },
    "autoload": {
        "psr-4": {
            "Acme\\Chapter07\\Buckpal\\": "src/Chapter07/"
        }
    },
    "authors": [
        {
            "name": "iamapen",
            "email": "iamapen@studiopoppy.com"
        }
    ],
    "require": {
      "ext-mbstring": "*",
      "ext-pdo": "*",
        "ramsey/uuid": "^4.7.6",
        "illuminate/database": "11.21.0",
        "illuminate/container": "^11.23"
    },
    "config": {
        "platform": {
            "php": "8.3.9"
        },
        "sort-packages": true
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.10.2",
        "phpunit/phpunit": "^11.3"
    }
}
